{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nettoyeur",
  "version": "0.1.0",
  "identifier": "com.drrakendu78.nettoyeur",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nettoyeur",
        "width": 1000,
        "height": 680,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "theme": "Light",
        "backgroundColor": "#F5F5F7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Drrakendu78",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
