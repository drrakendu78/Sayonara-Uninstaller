{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sayonara Uninstaller",
  "version": "0.1.2",
  "identifier": "com.drrakendu78.sayonara",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sayonara Uninstaller",
        "width": 1000,
        "height": 680,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "theme": "Light",
        "backgroundColor": "#F5F5F7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEMDYyQjI1NTY3RkNEMEUKUldRT3pYOVdKU3NHN1oxcnpmMnNRQklaRWRQeXhZTEFCaFF1amFmVXdoRkduNkd1VjUvRlRYWDgK",
      "endpoints": [
        "https://github.com/drrakendu78/Sayonara-Uninstaller/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Drrakendu78",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
